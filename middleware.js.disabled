// middleware.js
// Next.js middleware for URL handling

import { NextResponse } from 'next/server';

// Map old flat URLs to new hierarchical structure
const legacyUrlMappings = {
  '/home': '/navigation/home',
  '/projects-overview': '/navigation/projects-overview',
  '/knowledge-studio': '/app/knowledge/studio',
  '/graphnavigator': '/app/knowledge/studio/graph-navigator',
  '/ea-studio': '/app/workspaces/enterprise-architecture',
  '/product-design-workspace': '/app/workspaces/product-design',
  '/diagram-workspace': '/app/workspaces/diagram',
  '/requirements-studio': '/app/workspaces/requirements',
  '/system-dynamics': '/app/reasoning/system-dynamics',
  '/dynamic-work-design': '/app/reasoning/dynamic-work-design',
  '/negotiation-studio': '/app/reasoning/negotiation',
};

export function middleware(request) {
  const { pathname } = request.nextUrl;

  // Skip for API routes, static files, admin, and other non-app routes
  if (
    pathname.startsWith('/api') ||
    pathname.startsWith('/_next') ||
    pathname.startsWith('/admin') ||
    pathname === '/login' ||
    pathname === '/help' ||
    pathname === '/' ||
    pathname.startsWith('/static') ||
    pathname.includes('.')  // Skip files with extensions
  ) {
    return NextResponse.next();
  }

  // Check if this is a legacy URL that should be redirected
  if (legacyUrlMappings[pathname]) {
    // Get last domain from cookie
    const lastDomain = request.cookies.get('lastDomainId')?.value;

    if (lastDomain) {
      // Redirect to hierarchical URL with domain
      const newUrl = new URL(`/${lastDomain}${legacyUrlMappings[pathname]}`, request.url);
      return NextResponse.redirect(newUrl);
    }
    // If no domain cookie, let the page handle it (will use default domain)
  }

  return NextResponse.next();
}

export const config = {
  matcher: [
    /*
     * Match all request paths except for the ones starting with:
     * - api (API routes)
     * - _next/static (static files)
     * - _next/image (image optimization files)
     * - favicon.ico (favicon file)
     */
    '/((?!api|_next/static|_next/image|favicon.ico).*)',
  ],
};
