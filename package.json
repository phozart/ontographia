{
  "name": "Ontographia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "next lint",
    "ci": "npm run lint && npm run test && npm run build",
    "docs:detect": "node scripts/docs/detect-changes.js",
    "docs:watch": "node scripts/docs/doc-watcher.js watch",
    "docs:report": "node scripts/docs/doc-watcher.js report",
    "docs:prompt": "node scripts/docs/doc-watcher.js prompt",
    "docs:setup-hooks": "node scripts/docs/setup-hooks.js install",
    "postinstall": "node scripts/docs/setup-hooks.js install 2>/dev/null || true"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.15.14",
    "@mui/material": "^5.15.14",
    "@mui/x-data-grid": "^8.21.0",
    "@mui/x-tree-view": "^8.21.0",
    "@xyflow/react": "^12.10.0",
    "bcryptjs": "^2.4.3",
    "cytoscape": "3.30.2",
    "dataloader": "^2.2.3",
    "eslint-config-next": "^16.1.0",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "neo4j-driver": "5.25.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "pg": "^8.16.3",
    "react": "^19.2.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.1",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-mocks-http": "^1.17.2"
  }
}
